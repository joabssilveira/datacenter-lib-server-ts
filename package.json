    }
  },
  "files": [
    "dist",
    "src"
  ],
  "homepage": "https://github.com/joabssilveira/datacenter-lib-server-ts",
  "keywords": [],
  "license": "MIT",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "name": "datacenter-lib-server-ts",
  "peerDependencies": {
    "datacenter-lib-common-ts": "^1.3.5",
    "fwork-jsts-common": "^2.0.21",
