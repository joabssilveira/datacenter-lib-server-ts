	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"husky": "^9.1.7",
		"standard-version": "^9.5.0",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=10"
	},
	"files": [
