    "husky": "9.1.7",
    "sequelize": "6.37.8",
    "standard-version": "9.5.0",
    "tslib": "2.8.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=10"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
